# Public address of this web app (inlined into the browser bundle)
NEXT_PUBLIC_APP_URL=

# Supabase project, for sign-in only. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The Go API. Every provider key and privileged call lives behind it, so this is
# the only backend setting the frontend needs. List this app's origin in the
# API's WEBSOCKET_ALLOWED_ORIGINS.
NEXT_PUBLIC_API_URL=

# Optional. Which social sign-in buttons to show, comma separated: google, facebook.
# Empty means password sign-in only.
NEXT_PUBLIC_AUTH_PROVIDERS=
