{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {},
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": [".next/types/**"]
    },
    "typecheck": {
      "dependsOn": ["typegen", "build"]
    },
    "format:check": {},
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
