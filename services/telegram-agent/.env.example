# Copy to .env and fill in for local testing, or set these as Vercel
# project environment variables for deployment. Never commit the real
# values. See README.md for how to obtain each one.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs allowed to issue commands.
TELEGRAM_ALLOWED_USER_IDS=
# Random string you choose; registered with Telegram's setWebhook as
# secret_token and checked on every incoming request.
TELEGRAM_WEBHOOK_SECRET=

# --- GitHub ---
# Fine-grained PAT (or classic PAT) with Contents: read/write, Pull
# requests: read/write, and Actions: read/write on the target repository.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_FILE=telegram-claude-task.yml

# --- Callback security ---
# Shared HMAC secret. Set this exact same value as a GitHub Actions repo
# secret of the same name (GITHUB_WEBHOOK_SECRET) so the workflow's
# completion callback can be verified here.
GITHUB_WEBHOOK_SECRET=

# --- Cross-task memory (optional) ---
# Leave both unset and the bot behaves exactly as before: JOURNAL.md stays
# the only cross-task memory. Set both to also write a bot_memory row
# (supabase/migrations/0076_bot_memory.sql) for every finished task. Use
# this project's service role key, not the anon key - see README.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
