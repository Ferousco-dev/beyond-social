# Node environment: development | test | production
NODE_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Port for the mail service liveness/health HTTP endpoint
MAIL_PORT=9200

# Redis for the BullMQ mail queue (docker compose up -d)
REDIS_URL=redis://127.0.0.1:6379

# Supabase service role, so the service can read templates and update deliveries
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email provider. With no API key the service refuses to send and
# marks deliveries blocked, which is the state it ships in until credentials exist.
MAIL_PROVIDER_API_KEY=
MAIL_FROM=
