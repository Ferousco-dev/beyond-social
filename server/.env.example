PORT=8080
APP_ENV=development
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=15s

# Required. Tokens are verified against {SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_URL=https://your-project.supabase.co
# Only for projects still on the legacy shared HS256 secret. Leave empty when
# the project uses asymmetric signing keys (ES256/RS256).
SUPABASE_JWT_SECRET=

# Required in production. Use the direct or pooler connection string.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Comma-separated exact origins allowed to open WebSockets. Required in
# production; "*" is rejected.
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000

# Base64 32 byte key (openssl rand -base64 32) that encrypts provider keys pasted
# into the admin screen. Required for the admin to manage keys in the product.
APP_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Provider keys are optional here: an admin can paste them in instead, and a
# pasted key overrides these. Set them to start with keys already in place.
APIFY_API_TOKEN=replace-with-apify-token
KIE_API_KEY=replace-with-kie-api-key
# Optional actor overrides; defaults are clockworks/tiktok-scraper and apify/instagram-scraper.
APIFY_TIKTOK_ACTOR=
APIFY_INSTAGRAM_ACTOR=

# Optional. When set, KIE is given {PUBLIC_BASE_URL}/api/v1/callbacks/kie and
# reports completion immediately; without it jobs are tracked by polling alone.
PUBLIC_BASE_URL=

# Comma separated. These addresses become admins when they sign in; every other
# setting and provider key is then managed from the admin console.
ADMIN_EMAILS=
# Optional. The webhook HMAC key from the KIE settings page. When set, callbacks
# with a bad signature are rejected.
KIE_WEBHOOK_HMAC_KEY=
# Optional. Clones voices and renders speech for Live Avatar videos. The admin
# can also paste it later under Provider keys.
ELEVENLABS_API_KEY=

# Required. HeyGen avatar registration and avatar video generation.
HEYGEN_API_KEY=replace-with-heygen-api-key
# Optional. The secret of a webhook endpoint registered with HeyGen. When set,
# HeyGen callbacks must carry a valid signature. Callbacks are only hints either
# way: the video is always re-read from HeyGen's API.
HEYGEN_WEBHOOK_SECRET=
# Required. Lets the service give HeyGen a short-lived signed link to a private
# recording and delete the recording afterwards. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Required. Gemini API key for workflow planning. Server-side only: it must
# never reach the browser.
GEMINI_API_KEY=replace-with-gemini-api-key
# Optional. Planning model override. Defaults to gemini-3.8-flash.
GEMINI_MODEL=

# Optional. Slack or Discord webhook that is told when a provider runs out of
# credit or a key stops working. Alerts are stored and logged either way.
ALERT_WEBHOOK_URL=

# Optional: sign-in credentials for publishing to social accounts. An admin can
# paste these in instead. Each platform's redirect URL, set in its developer
# console, is PUBLIC_BASE_URL + /api/v1/social/callback/<platform>
# (youtube, tiktok, instagram). APP_URL is where people land afterwards.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
