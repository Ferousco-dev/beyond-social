# Public base URL of the admin console (inlined into the browser bundle)
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# Supabase (from `supabase start` or your project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Service role bypasses RLS; every admin read that crosses tenant
# boundaries goes through it, so it must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# The web app that owns the knowledge base. The console reads the learning queue
# itself but cannot decide a candidate: promoting one re-resolves it against the
# corpus, which needs the embedder and vector store.
WEB_APP_URL=http://localhost:3000

# Shared secret for those calls. Must match INTERNAL_API_SECRET in the web app.
INTERNAL_API_SECRET=
