# Public base URL of the web app (inlined into the browser bundle)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (from `supabase start` or your project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Service role bypasses RLS; used for the prompt-engine RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# Prompt intelligence engine (server-only). Enhancement + learning activate only
# when an embedder (Voyage or OpenAI) and Anthropic are set, and the corpus has
# been ingested into pgvector (see packages/prompt-engine `pnpm ingest`).
VOYAGE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Billing (server-only). Checkout stays disabled until the secret and webhook
# secret are both set. Price ids differ between test and live mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_STUDIO=

# Social publishing (direct platform APIs). Each platform is independent, so
# one can go live while another is still in app review.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Trend discovery
FIRECRAWL_API_KEY=

# Shared secret for scheduled jobs. Required: discovery cannot be triggered
# without it, so an unset value disables the endpoint entirely.
CRON_SECRET=

# Encrypts webhook signing secrets at rest, 32 bytes base64
# (`openssl rand -base64 32`). The edge function that sends deliveries needs the
# same value, so set it in both places. Unset means endpoints cannot be
# registered, which the page says rather than storing a secret it cannot use.
WEBHOOK_SECRET_KEY=

# Shared secret for server-to-server calls from the admin console, which is how
# a learning candidate is promoted or rejected. Unset closes that route rather
# than opening it. Must match INTERNAL_API_SECRET in the console.
INTERNAL_API_SECRET=

# Turns the nightly retention job from a dry run into a real one. Off by
# default, and deliberately a setting: the scheduled run has always been a dry
# run, so read the counts it reports before enabling deletion.
RETENTION_APPLY=

# Ceiling on what one user may spend on model calls, in dollars, over
# AI_SPEND_WINDOW_HOURS. Empty uses the defaults ($5 over 24 hours). Zero
# disables the ceiling.
AI_SPEND_LIMIT_USD=
AI_SPEND_WINDOW_HOURS=
