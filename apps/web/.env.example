# Public base URL of the web app (inlined into the browser bundle)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (from `supabase start` or your project settings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Service role bypasses RLS; used for the prompt-engine RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# Prompt intelligence engine (server-only). Enhancement + learning activate only
# when an embedder (Voyage or OpenAI) and Anthropic are set, and the corpus has
# been ingested into pgvector (see packages/prompt-engine `pnpm ingest`).
VOYAGE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
