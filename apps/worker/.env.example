# Node environment: development | test | production
NODE_ENV=development

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info

# Port for the worker liveness/health HTTP endpoint
WORKER_PORT=9100

# Redis for the BullMQ publishing queue (docker compose up -d)
REDIS_URL=redis://127.0.0.1:6379

# Supabase service role, so the worker can read/update posts (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Publishing provider (Upload-post / Blotato) API key
UPLOAD_POST_API_KEY=
