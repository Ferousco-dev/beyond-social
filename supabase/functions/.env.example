# Edge function secrets. Copy to supabase/functions/.env (git-ignored) for local
# development. SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically by the local edge runtime, so they are not listed here.

# kie.ai video generation API key (https://kie.ai)
KIE_API_KEY=

# Shared secret that authenticates the kie.ai webhook. Use any long random
# string, e.g. `openssl rand -hex 32`.
KIE_CALLBACK_SECRET=

# Decrypts webhook signing secrets so deliveries can be signed. The same value
# as WEBHOOK_SECRET_KEY in the web app: 32 bytes, base64, e.g.
# `openssl rand -base64 32`. Without it, deliveries are skipped rather than sent
# unsigned.
WEBHOOK_SECRET_KEY=

# Origins allowed to call these functions from a browser. Set both to restrict
# CORS to the app's own addresses; local development origins are always allowed.
# While both are unset the functions answer Access-Control-Allow-Origin: * as
# they always have.
APP_ORIGIN=
ADMIN_ORIGIN=
